{
  "name": "mbrg",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @mbrg/web",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web",
    "dev": "npm run dev -w @mbrg/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
